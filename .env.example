DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Optional: Jev finite choices, enabled manually in Quality > Fast decisions.
VERCEL_AI_GATEWAY_API_KEY=
# Model page-review decisions: off | shadow (default) | pass. Requires Fast decisions routing.
BOOK_MAKER_PAGE_REVIEW_DECISIONS=shadow
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Docker Compose supplies the private PaddleOCR-VL service URL to the worker.
# Set this only when running the worker outside Compose against a local OCR service.
# GEMINI_API_KEY enables Google OCR when local OCR is absent or fails.
# A fallback call sends the affected page/image to Google and incurs API usage.
# SOURCE_OCR_URL=http://localhost:8080
# Optional OCR-specific Gemini model; otherwise uses GEMINI_TEXT_MODEL.
# GEMINI_OCR_MODEL=gemini-2.5-flash
# Per-provider timeout; local + Google attempts can each use this budget.
# SOURCE_OCR_TIMEOUT_MS=600000

DATABASE_URL=postgresql://bookmaker:bookmaker@localhost:55432/bookmaker?schema=public
REDIS_URL=redis://localhost:6379

# Local S3-compatible storage. Start with: docker compose up -d minio-init
# API/worker containers use http://minio:9000; host commands use localhost.
S3_BUCKET=ai-book-maker
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=bookmaker
AWS_SECRET_ACCESS_KEY=bookmaker-local-only

API_HOST=0.0.0.0
API_PORT=4001
PUBLIC_API_URL=http://localhost:4001
WEB_PORT=5173
WEB_PASSWORD=bookmaker
# Google sign-in: Web OAuth client ID, also passed to Flutter with --dart-define.
# No client secret is needed. See docs/google-sign-in.md.
GOOGLE_SIGN_IN_CLIENT_ID=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
AUDIOBOOK_OPENAI_FALLBACK_ENABLED=true
GEMINI_TTS_SAFE_RPD_BUDGET=90
# Google's free grounded-search allowance per Google project, which grounded prompts are priced
# against. Lower these when anything outside this deployment shares the key; 0 = always list price.
# SEARCH_GROUNDING_FREE_GEMINI_25_FLASH_PER_DAY=1500
# SEARCH_GROUNDING_FREE_GEMINI_25_PRO_PER_DAY=1500
# SEARCH_GROUNDING_FREE_GEMINI_3_PER_MONTH=5000
VOICE_CHAT_PROVIDER=gemini_live
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=alloy
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Achird
VOICE_RTC_STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
VOICE_RTC_TURN_TTL_SECONDS=3600
CLOUDFLARE_TURN_TOKEN=
CLOUDFLARE_API_TOKEN=

# Local scratch paths only; durable artifacts are in S3/MinIO (see docs/storage.md).
BOOK_STORAGE_DIR=./storage/books
IMAGE_STORAGE_DIR=./storage/images
VOICE_STORAGE_DIR=./storage/voice
# How long a render/publication scratch file must sit untouched before the worker's
# sweep treats it as abandoned. Quiet time is the only thing separating an orphan
# from a compile another process is running right now, so this is hours, not minutes.
# EXPORT_TEMP_RETENTION_HOURS=6
MAX_PARALLEL_PAGE_JOBS=4
MAX_PARALLEL_IMAGE_JOBS=2
# Worker lanes (packages/core/src/jobLanes.ts). Unset, the long lane runs
# MAX_PARALLEL_PAGE_JOBS jobs, the image lane MAX_PARALLEL_IMAGE_JOBS pictures,
# the compile lane one generation compile, plans and edits get 2, and the
# background lane (the composition prep while a reader reads the plan) gets 4.
# WORKER_LONG_CONCURRENCY=
# WORKER_IMAGE_CONCURRENCY=
# WORKER_COMPILE_CONCURRENCY=1
# WORKER_INTERACTIVE_CONCURRENCY=2
# WORKER_BACKGROUND_CONCURRENCY=4
MOCK_AI=false
# Closed debug deployment: blocks new accounts and allows missing Play/SMTP settings.
DEBUG_MODE=false
# Push notifications (docs/push-notifications.md). In development a push is a
# `push.mock_sent` log line unless MOCK_PUSH=false and a Firebase key is set.
# MOCK_PUSH=true
# A path outside the repo: the key can send to every install of the app.
# FCM_SERVICE_ACCOUNT_FILE=/path/outside/the/repo/firebase-service-account.json

# Docker dev: polling watchers (set automatically in docker-compose.yml)
# DEV_WATCH_POLLING=true
# CHOKIDAR_USEPOLLING=true
