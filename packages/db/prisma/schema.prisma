  projectId           String
  planVersionId       String?
  /// The account-level character this cast row IS, when the book was built from
  /// an @-mention. Deliberately not a relation: a book outlives the library row
  /// it was made from, so this is the same copy-by-value the plan snapshot is —
  /// it only ever decides what the cast sheet shows and which portrait it draws.
  libraryCharacterId  String?
  name                String
  role                String
  description         String
  traits              Json
  visualRules         Json
  source              String               @default("PLAN")
  status              VoiceCharacterStatus @default(CANDIDATE)
