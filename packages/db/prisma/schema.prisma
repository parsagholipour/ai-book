model ModerationReport {
  id             String                     @id @default(cuid())
  reporterUserId String?
  projectId      String?
  imageAssetId   String?
  targetType     ModerationReportTargetType
  reason         ModerationReportReason
  comment        String?
  status         ModerationReportStatus     @default(PENDING)
  targetSnapshot Json
  reviewerUserId String?
  reviewedAt     DateTime?
  reviewNotes    String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  reporter   User?       @relation("ModerationReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reviewer   User?       @relation("ModerationReportReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  imageAsset ImageAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@index([reporterUserId, createdAt])
  @@index([projectId, createdAt])
  @@index([imageAssetId, createdAt])
  @@index([status, createdAt])
