enum LibraryCharacterPortraitStatus {
  NONE
  QUEUED
  GENERATING
  READY
  FAILED
}

/// What the uploaded photo turned out to be, as judged once at upload time.
/// A real photograph has to be drawn before a book may use it; an illustration
/// is already the character's look and is adopted as the reference verbatim.
/// UNKNOWN is the honest answer when the vision read was unsure — it is treated
/// as PHOTOGRAPH everywhere, because adopting a real face by mistake is the
/// only failure here that cannot be undone.
enum LibraryCharacterPhotoKind {
  PHOTOGRAPH
  ILLUSTRATION
  UNKNOWN
}

/// Where `portraitPath` came from. ADOPTED_UPLOAD is the user's own artwork,
/// copied rather than drawn — free, and deleted again with the photo it is.
/// GENERATED is a paid redraw and outlives the photo it was made from.
enum LibraryCharacterPortraitSource {
  GENERATED
  ADOPTED_UPLOAD
}

/// Where the bytes of one retained character image came from. GENERATED is a
/// paid `generate-character-portrait` render; UPLOAD is a file the reader chose
/// and cropped, whether or not it was ever adopted as the reference.
enum LibraryCharacterImageSource {
  UPLOAD
  GENERATED
}

/// A user-defined character in the account-wide library. Books reference it by
/// snapshot (`mediaSettings.mobile.characters`) and by name inside plans, never
/// by foreign key, so deleting one can never break a book already made from it.
model LibraryCharacter {
  id             String                         @id @default(cuid())
  userId         String
  name           String
  description    String
  /// Ordered optional profile fields, e.g. [{"key":"Age","value":"9"}].
  fields         Json
  /// Filenames inside IMAGE_STORAGE_DIR/characters/<userId>/, never full paths.
  photoPath      String?
  /// Null on rows uploaded before the photo was ever read.
  photoKind      LibraryCharacterPhotoKind?
  /// A description derived from the photo, offered to the user and never
  /// applied on their behalf. Cleared once they accept, edit, or dismiss it.
  suggestedDescription String?
  /// What this character LOOKS like, in words. `description` is who they are —
  /// free text the user writes, routinely carrying no appearance at all — while
  /// the look lives only in the portrait's pixels, which no text model ever
  /// sees. Without this the planner invents a look for a character it was told
  /// to reuse, and that invented look wins at render time because the scene
  /// prompt outranks the attached reference images.
  appearance           String?
  portraitPath   String?
  portraitSource LibraryCharacterPortraitSource?
  portraitStatus LibraryCharacterPortraitStatus @default(NONE)
  portraitError  String?
  portraitJobId  String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  images           LibraryCharacterImage[]
  outgoingMentions LibraryMention[] @relation("LibraryMentionSource")
  incomingMentions LibraryMention[] @relation("LibraryMentionTarget")

  @@unique([userId, name])
  @@index([userId, createdAt])
}

/// What a description @mention points at. CHARACTER is the only kind with a
/// library table today; LOCATION and OTHER share this edge so those libraries
/// can land without another primary-key rewrite. CHECKs in the migration
/// enforce the exclusive-arc: CHARACTER rows set `targetCharacterId = targetId`
/// and leave `otherType` null; LOCATION leaves both null; OTHER requires a
/// user-typed `otherType` and no character FK. Location/Other FKs are added
/// with those tables.
enum LibraryMentionTargetKind {
  CHARACTER
  LOCATION
  OTHER
}

/// One durable, directed @mention from a library-item description to a library
/// target. The description remains the prose authority; this row gives its
/// @Name token a stable identity across renames. The source is a character
/// today; Location/Other sources land with those tables.
///
/// A migration CHECK refuses a character that mentions itself, and it is scoped
/// to CHARACTER: only there does `targetId` share a key space with
/// `sourceCharacterId`, so comparing the two across the other kinds would refuse
/// a row whose ids merely collide.
model LibraryMention {
  sourceCharacterId String
  targetKind        LibraryMentionTargetKind @default(CHARACTER)
  /// Identity of the target in its own library. For CHARACTER this is the
  /// LibraryCharacter id and equals `targetCharacterId`.
  targetId          String
  /// Set only when `targetKind` is OTHER: the user-typed subtype (e.g. "sword").
  ///
  /// `VarChar(80)` is the same ceiling `LibraryMention_target_arc` spells, kept
  /// on the column so the model states the bound instead of leaving it to a
  /// CHECK nothing above the database can read. It is the floor of three
  /// statements of one rule, not the gate: `libraryMentionOtherTypeSchema`
  /// (apps/api/src/mobile/characterSchemas.ts) trims and bounds it at the door,
  /// which is the only one of the three that can answer a reader with a 400.
  /// Note the column refuses a long value as SQLSTATE `22001` (Prisma `P2000`)
  /// rather than the `23514` the CHECK raises, so the length half no longer
  /// reaches `namesMentionCheckConstraint` — the trim and the arc still do.
  otherType         String?                  @db.VarChar(80)
  /// First textual occurrence in the source description, **among the rows of
  /// this `targetKind`**. One write replaces one kind's rows and numbers what
  /// it inserts from 0 (`REPLACED_MENTION_KINDS`,
  /// apps/api/src/mobile/libraryMentionLinks.ts), so two kinds written by two calls
  /// both start there and the numbers mean nothing against each other. Reads
  /// compare them inside a kind and nowhere else: `libraryMentionInclude`
  /// (packages/db/src/libraryMentions.ts) orders `targetKind`, then this, then
  /// `targetId` — the rest of the primary key, so one source's rows can never
  /// come back tied. Used for recursive cast expansion; repeated mentions of
  /// one target still occupy one row.
  sortOrder         Int
  /// Character FK, populated iff `targetKind` is CHARACTER. Cascade-deletes
  /// those mentions when the character goes.
  targetCharacterId String?

  sourceCharacter LibraryCharacter  @relation("LibraryMentionSource", fields: [sourceCharacterId], references: [id], onDelete: Cascade)
  targetCharacter LibraryCharacter? @relation("LibraryMentionTarget", fields: [targetCharacterId], references: [id], onDelete: Cascade)

  // Two ways in and no third: every read enters by `sourceCharacterId` — the
  // key's leading column, which also serves the kind-filtered delete on rewrite
  // — or by `targetCharacterId`. 000057's `([sourceCharacterId, sortOrder])`
  // was dropped by 000058 along with the read order that named it: `sortOrder`
  // is the second key of `libraryMentionOrder` now, so that index could no
  // longer produce the ordering, and the lookup it was left doing is one this
  // key already does. There is no index by target kind either. One of those
  // goes in with the Location/Other read that needs it.
  @@id([sourceCharacterId, targetKind, targetId])
  @@index([targetCharacterId])
}

/// One retained version of a character's picture — every upload and every
/// drawing, kept until the reader deletes it or the per-character cap prunes it.
///
/// `LibraryCharacter.photoPath` and `portraitPath` remain the pointers and this
/// table is purely additive. That is deliberate: `usedInBooks`, `portraitUrl`,
/// both asset routes and `libraryCharacterSnapshotsForBuild` all share one
/// expression over those two columns, and the build snapshot is a copy-by-value
/// that must never carry an id from here back into a book.
///
/// Rows are immutable and there is no `updatedAt`: the file is written once
/// under a name nothing re-derives, so one image id means one set of bytes for
/// good and the app may hold them for as long as it likes.
model LibraryCharacterImage {
  id          String                      @id @default(cuid())
  characterId String
  /// Denormalized from the character so a lookup can carry a third ownership
  /// predicate. The disk path's user segment is still built from the bearer
  /// token, never from this column.
  userId      String
  source      LibraryCharacterImageSource
  /// A filename inside IMAGE_STORAGE_DIR/characters/<userId>/, never a path.
  fileName    String
  byteSize    Int?
  width       Int?
  height      Int?
  /// What this upload was judged to be, kept per row because
  /// `LibraryCharacter.photoKind` is overwritten by the next upload and would
  /// then describe a different picture.
  photoKind   LibraryCharacterPhotoKind?
  /// Whether this image may become the book reference with no redraw: the
  /// verdict `canAdoptCharacterPhoto` reached at ingest, frozen. Promoting an
  /// image consults this and never re-derives it — the renderer is told an
  /// adopted reference *is* the character and to reproduce its face exactly, so
  /// a re-derivation would be a one-tap route from a photograph of a real
  /// person to the authoritative design source for every page.
  referenceEligible Boolean @default(false)
  /// What this picture was drawn from when that is not what was asked for:
  /// `{ copyrightRewrite: { refusalReason, replaced, unverifiedReferenceImages?, prompt } }`, the same key
  /// `ImageAsset.metadata` carries. A portrait is the seed for every book's
  /// character reference sheets, so a drawing whose prompt an IP filter refused
  /// and a text model rewrote had nowhere to be recorded and left no trace at
  /// all. Null on an upload and on a drawing nothing was rewritten for.
  metadata    Json?
  createdAt   DateTime @default(now())

  character LibraryCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, fileName])
  @@index([characterId, createdAt])
}

