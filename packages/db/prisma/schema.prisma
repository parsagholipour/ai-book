model AccountDeletionRequest {
  id          String                       @id @default(cuid())
  userId      String?
  email       String
  status      AccountDeletionRequestStatus @default(PENDING)
  reason      String?
  metadata    Json
  requestedAt DateTime                     @default(now())
  completedAt DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([email, requestedAt])
}

model GenerationJob {
  id         String    @id @default(cuid())
  projectId  String
  attemptId  String?
  type       JobType
  status     JobStatus @default(QUEUED)
  dedupeKey  String?   @unique
  progress   Int       @default(0)
  message    String?
  error      String?
  bullJobId  String?
  dispatchAttempts Int @default(0)
  nextDispatchAt DateTime?
  dispatchedAt DateTime?
  contentRevision Int?
  qualityReport Json?
  /// Whether `qualityReport` is the *project's* verdict once this job writes one.
  /// Derived from type + payload where the row is created (`jobOwnsQualityVerdict`),
  /// so the read side can fetch the owning compile directly instead of scanning
  /// recent jobs: detached export repairs and presentation-only recompiles report
  /// deterministic checks alone and must not replace a full model QA pass.
  ownsQualityVerdict Boolean @default(false)
  payload    Json
  steps      Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  providerLogs ProviderCallLog[]
  creditLedger CreditLedgerEntry[]
  editOperations BookEditOperation[]
  attempt       GenerationAttempt?  @relation("GenerationAttemptJobs", fields: [attemptId], references: [id], onDelete: SetNull)
  primaryForAttempt GenerationAttempt? @relation("GenerationAttemptPrimaryJob")

  @@index([projectId, type, status])
  @@index([projectId, type, ownsQualityVerdict, createdAt])
  @@index([status, nextDispatchAt])
  @@index([attemptId])
}

/// One durable, immutable command claim around every priced asynchronous
/// generation. The claim, debit, quota/entitlement writes, domain mutation,
/// and primary job are created in one serializable transaction.
model GenerationAttempt {
  id                 String                  @id @default(cuid())
  userId             String
  commandKey         String                  @unique
  requestFingerprint String
  status             GenerationAttemptStatus @default(QUEUED)
  operation          CreditOperation
  quotedCredits      Int
  projectId          String?
  editOperationId    String?
  ledgerEntryId      String?                 @unique
  primaryJobId       String?                 @unique
  retryOfAttemptId   String?                 @unique
  error              String?
  refundPending      Boolean                 @default(false)
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  editOperation BookEditOperation? @relation(fields: [editOperationId], references: [id], onDelete: SetNull)
  ledgerEntry   CreditLedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  primaryJob    GenerationJob?     @relation("GenerationAttemptPrimaryJob", fields: [primaryJobId], references: [id], onDelete: SetNull)
  jobs          GenerationJob[]    @relation("GenerationAttemptJobs")
  retryOf       GenerationAttempt? @relation("GenerationAttemptRetry", fields: [retryOfAttemptId], references: [id], onDelete: SetNull)
  retryAttempt  GenerationAttempt? @relation("GenerationAttemptRetry")

  @@index([userId, createdAt])
  @@index([projectId, status])
  @@index([editOperationId])
  @@index([status, refundPending, updatedAt])
}

model ProviderCallLog {
  id              String   @id @default(cuid())
  projectId       String?
  generationJobId String?
  provider        String
  model           String
  purpose         String
  promptTokens    Int?
  outputTokens    Int?
  cacheHitTokens  Int?
  costHint        Float?
  durationMs      Int?
  metadata        Json
  createdAt       DateTime @default(now())

  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  generationJob GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([generationJobId])
  @@index([provider, model, purpose, createdAt])
}

/// One metered realtime call between a user and a book character.
///
/// Voice is the only operation priced by time, so unlike every other paid
/// action it needs a durable row: the credit hold has to survive the app being
/// killed mid-call, and a call nobody settles has to be settleable from the
/// last heartbeat. `heldCredits` is the sum of the still-RESERVED ledger
/// entries in `reservationEntryIds`; nothing is spent until the call ends.
model VoiceCall {
  id                 String    @id @default(cuid())
  userId             String
  projectId          String
  characterId        String
  status             String    @default("ACTIVE")
  reservationEntryIds String[]
  heldCredits        Int       @default(0)
  chargedCredits     Int       @default(0)
  elapsedSeconds     Int       @default(0)
  endReason          String?
  /// The tail of what was said, as `[{ speaker, text }]`, uploaded by the app
  /// while the call runs — audio never reaches us, so neither does a transcript
  /// unless the client sends one. Opaque JSON: it is read back whole to give
  /// the character a memory of earlier calls, and never queried into.
  transcript         Json?
  lastHeartbeatAt    DateTime  @default(now())
  startedAt          DateTime  @default(now())
  endedAt            DateTime?

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voiceCharacter VoiceCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([projectId, startedAt])
  @@index([status, lastHeartbeatAt])
  @@index([userId, characterId, startedAt])
}

model VoiceCallEvent {
  id                     String   @id @default(cuid())
  projectId              String
  characterId            String
  clientCallId           String
  phase                  String
  attempt                Int?
  elapsedMs              Int?
  connectionState        String?
  iceConnectionState     String?
  iceGatheringState      String?
  candidatePairType      String?
  candidateProtocol      String?
  currentRoundTripTimeMs Int?
  packetsLost            Int?
  jitterMs               Int?
  error                  String?
  metadata               Json
  createdAt              DateTime @default(now())

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voiceCharacter VoiceCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([characterId, createdAt])
  @@index([clientCallId])
}

model VoiceConversation {
  id                   String   @id @default(cuid())
  projectId            String
  parentConversationId String?
  rootConversationId   String?
  prompt               String
  characterSnapshots   Json
  transcript           Json
  provider             String
  model                String
  audioPath            String
  durationMs           Int?
  metadata             Json
  createdAt            DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([parentConversationId])
  @@index([rootConversationId, createdAt])
}

/// One narrated rendering of a book. There is at most one per project: asking for
/// a new narrator replaces the old row (and its files) rather than versioning it.
/// `contentRevision` is the project revision the narration was read from, which is
/// what lets the app say "this audiobook predates your latest edits".
model Audiobook {
  id              String          @id @default(cuid())
  projectId       String          @unique
  voice           String
  status          AudiobookStatus @default(GENERATING)
  contentRevision Int?
  totalDurationMs Int?
  speechProvider  String?
  speechModel     String?
  speechVoice     String?
  fallbackReason  String?
  renderVersion   Int             @default(1)
  generationJobId String?
  error           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapters AudiobookChapter[]
}

/// Audio and its sentence timeline live on disk under
/// <AUDIO_STORAGE_DIR>/<projectId>/<audiobookId>/chapter-<index>.{mp3,timeline.json},
/// so the row carries no path — only the facts the manifest needs before a
/// download. A chapter flips to READY only once both files are in place, which is
/// what makes a retried job safe to resume.
model AudiobookChapter {
  id                  String                 @id @default(cuid())
  audiobookId         String
  index               Int
  title               String
  status              AudiobookChapterStatus @default(PENDING)
  durationMs          Int?
  estimatedDurationMs Int?
  byteSize            Int?
  segmentCount        Int?
  pageStartIndex      Int?
  pageEndIndex        Int?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  audiobook Audiobook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([audiobookId, index])
  @@index([audiobookId, index])
}

model Embedding {
  id        String   @id @default(cuid())
  projectId String
  scope     String
  sourceId  String?
  text      String
  metadata  Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
