generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum TemplateCategory {
  KIDS
  SCIENCE
  STORY
  EDUCATION
  BUSINESS
  SELF_HELP
  HEALTH
  BIOGRAPHY
  HISTORY
  SOCIETY
  ARTS
  CUSTOM
}

enum ProjectStatus {
  DRAFT
  PLANNING
  PLAN_READY
  GENERATING
  EDITING
  REVIEW_REQUIRED
  COMPLETE
  FAILED
}

enum PlanStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  CANCELED
  FAILED
}

enum JobType {
  PLAN_BOOK
  REVISE_PLAN
  GENERATE_BOOK
  GENERATE_PAGE
  GENERATE_IMAGE
  COMPILE_EXPORT
  APPLY_BOOK_EDIT
  REPLAN_BOOK
  PREPARE_CHARACTER_CANDIDATES
  BUILD_CHARACTER_PERSONA
  RESEARCH
  IMPORT_BOOK
  CONTINUE_BOOK
  GENERATE_AUDIOBOOK
  GENERATE_CHARACTER_PORTRAIT
}

enum AudiobookStatus {
  GENERATING
  COMPLETE
  FAILED
}

enum AudiobookChapterStatus {
  PENDING
  READY
  FAILED
}

enum AssetType {
  COVER
  CHARACTER_REFERENCE
  CHARACTER_PROFILE
  SCENE_ILLUSTRATION
  DIAGRAM
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BillingProductType {
  ONE_TIME_UNLOCK
  CREDIT_PACK
  SUBSCRIPTION
  INTERNAL_GRANT
}

enum BillingProvider {
  INTERNAL
  GOOGLE_PLAY
}

enum PurchaseStatus {
  PENDING
  VERIFIED
  GRANTED
  FAILED
  REVOKED
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  GRACE_PERIOD
  PAUSED
  CANCELED
  EXPIRED
}

enum UserEntitlementType {
  EXPORT_UNLOCK
  PREMIUM_PRESET
  PREMIUM_REVIEW
  EXTRA_IMAGES
  CREATOR_PLAN
  PRO_PLAN
  MAX_PLAN
}

enum UserEntitlementStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
}

enum CreditLedgerEntryType {
  GRANT
  RESERVE
  SPEND
  REFUND
  RELEASE
  ADJUSTMENT
}

enum CreditLedgerEntryStatus {
  RESERVED
  SETTLED
  REFUNDED
  VOIDED
}

enum CreditOperation {
  PLAN_GENERATION
  PREVIEW_GENERATION
  FULL_BOOK_GENERATION
  IMAGE_GENERATION
  COVER_REGENERATION
  PREMIUM_REVIEW
  EXPORT_UNLOCK
  PLAN_REVISION
  BOOK_TEXT_EDIT
  PAGE_REGENERATION
  BOOK_REPLAN
  VOICE_CALL_MINUTE
  AUDIOBOOK_GENERATION
  CHARACTER_PORTRAIT_GENERATION
  PURCHASE_CREDIT_GRANT
  SUBSCRIPTION_CREDIT_GRANT
  PLAN_ALLOWANCE_GRANT
  ADMIN_GRANT
}

enum GenerationAttemptStatus {
  QUEUED
  ACTIVE
  SUCCEEDED
  FAILED
  CANCELED
}

enum ProjectChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum BookEditOperationKind {
  PLAN_REVISION
  LOCAL_PATCH
  PAGE_REWRITE
  CHAPTER_REGENERATE
  BOOK_REPLAN
  MANUAL_EDIT
  CONTINUE_BOOK
  ADD_IMAGE
  MOVE_IMAGE
  REMOVE_IMAGE
  /// Insert, delete or reorder pages. One kind for all three; which one it was
  /// lives in BookEditOperation.classifier, along with the record undo reverses.
  RESTRUCTURE_PAGES
}

enum BookEditOperationStatus {
  QUEUED
  ACTIVE
  APPLIED
  FAILED
  CANCELED
}

enum ModerationReportTargetType {
  PROJECT
  IMAGE_ASSET
}

enum ModerationReportReason {
  OFFENSIVE
  HATE_OR_HARASSMENT
  SEXUAL_CONTENT
  VIOLENCE_OR_SELF_HARM
  CHILD_SAFETY
  DECEPTIVE_OR_MISLEADING
  PRIVACY_OR_COPYRIGHT
  OTHER
}

enum ModerationReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

enum AccountDeletionRequestStatus {
  PENDING
  COMPLETED
  CANCELED
  REJECTED
}

enum VoiceCharacterStatus {
  CANDIDATE
  APPROVED
  BUILDING
  READY
  REJECTED
  FAILED
}

model Template {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  category      TemplateCategory
  description   String
  defaultConfig Json
  styleRules    Json
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  projects      Project[]
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  displayName String?
  status      UserStatus @default(ACTIVE)
  disabledAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  passwordCredential      UserPasswordCredential?
  mobileSessions          MobileSession[]
  projects                Project[]
  creditAccount           UserCreditAccount?
  usageCounters           UsageCounter[]
  creditLedger            CreditLedgerEntry[]
  entitlements            UserEntitlement[]
  purchases               PurchaseRecord[]
  subscriptions           SubscriptionState[]
  moderationReports       ModerationReport[]       @relation("ModerationReportReporter")
  moderationReviews       ModerationReport[]       @relation("ModerationReportReviewer")
  accountDeletionRequests AccountDeletionRequest[]
  mobileCreationDrafts    MobileCreationDraft[]
  bookImports             BookImport[]
  voiceCalls              VoiceCall[]
  legalAcceptances        LegalAcceptance[]
  generationAttempts      GenerationAttempt[]
  passwordResetRequests   PasswordResetRequest[]
  libraryCharacters       LibraryCharacter[]
}

/// Append-only proof that a user affirmatively accepted a specific pair of
/// legal documents. Historical rows are preserved when the documents change.
model LegalAcceptance {
  id                     String   @id @default(cuid())
  userId                 String
  termsVersion           String
  privacyVersion         String
  acceptedAt             DateTime @default(now())
  source                 String
  termsAttested          Boolean
  ageGuardianAttested    Boolean
  ipHash                 String?
  userAgent              String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, termsVersion, privacyVersion, acceptedAt])
  @@index([acceptedAt])
}

/// Append-only operator history for the optional copyright prompt gate. The
/// newest version is active; no rows means disabled, preserving shipped
/// behavior until an operator deliberately enables the restriction.
model SafetySettingsRevision {
  id                           String   @id @default(cuid())
  version                      Int      @unique
  copyrightRestrictionsEnabled Boolean  @default(false)
  note                         String?
  updatedBy                    String?
  createdAt                    DateTime @default(now())

  @@index([createdAt])
}

/// Append-only operator history for per-feature generation quality gates.
/// Newest version wins. No rows means compiled defaults (the opposite of
/// SafetySettingsRevision, where empty means off).
model GenerationQualityRevision {
  id        String   @id @default(cuid())
  version   Int      @unique
  settings  Json
  note      String?
  updatedBy String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model UserPasswordCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A pending "forgot password" verification. Only the scrypt hash of the
/// emailed 6-digit code is stored; `attempts` caps guesses per code and a new
/// request replaces any older pending ones, so the newest email is always the
/// one that works.
model PasswordResetRequest {
  id            String    @id @default(cuid())
  userId        String
  codeHash      String
  expiresAt     DateTime
  attempts      Int       @default(0)
  consumedAt    DateTime?
  requestIpHash String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

model MobileSession {
  id                       String    @id @default(cuid())
  userId                   String
  accessTokenHash          String    @unique
  refreshTokenHash         String    @unique
  previousRefreshTokenHash String?   @unique
  refreshTokenRotatedAt    DateTime?
  accessTokenExpiresAt     DateTime
  refreshTokenExpiresAt    DateTime
  userAgent                String?
  ipHash                   String?
  revokedAt                DateTime?
  lastUsedAt               DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([accessTokenExpiresAt])
  @@index([refreshTokenExpiresAt])
}

model ProductCatalog {
  id           String             @id @default(cuid())
  sku          String             @unique
  title        String
  description  String?
  productType  BillingProductType
  provider     BillingProvider    @default(GOOGLE_PLAY)
  creditAmount Int                @default(0)
  priceMicros  BigInt?
  currency     String             @default("USD")
  active       Boolean            @default(true)
  metadata     Json
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  creditLedger  CreditLedgerEntry[]
  purchases     PurchaseRecord[]
  subscriptions SubscriptionState[]
}

/// Operator-set credit prices, kept as an append-only history rather than a
/// mutable settings row: the highest `version` *is* the current price list, an
/// empty table means "use the defaults compiled into packages/core", and a
/// revert is a new forward revision carrying an older one's values. One table
/// means the audit trail and the config can never disagree.
model CreditPricingRevision {
  id        String   @id @default(cuid())
  version   Int      @unique
  values    Json
  /// Only the keys that moved: { key: { from, to } }.
  changed   Json
  note      String?
  /// The operator console is one shared password, so this records that the
  /// console made the change, not which person did. `note` is the real trail.
  updatedBy String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Two pools, spent plan-first. `availableCredits` is what the user bought and
/// never expires; `planCredits` is the monthly allowance (free tier or
/// subscription period) and is reset — not topped up — at each period boundary,
/// so it cannot accumulate. An allowance past `planPeriodEnd` is unspendable
/// even before the reset lands. See `planPeriods.ts`.
model UserCreditAccount {
  userId                 String    @id
  availableCredits       Int       @default(0)
  reservedCredits        Int       @default(0)
  lifetimeCreditsGranted Int       @default(0)
  lifetimeCreditsSpent   Int       @default(0)
  planCredits            Int       @default(0)
  planCreditsPerPeriod   Int       @default(0)
  planPeriodStart        DateTime?
  planPeriodEnd          DateTime?
  /// `free:2026-08` or `sub:{tokenHash}:{periodEnd}` — the grant's idempotency anchor.
  planPeriodKey          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Non-credit monthly limits, one row per user per counter per period.
/// Today only `illustrated_books` (free tier: N illustrated generations a
/// month); the shape is generic so the next limit needs no migration.
model UsageCounter {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  /// UTC calendar month, `2026-08`.
  periodKey String
  used      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey])
  @@index([userId, kind])
}

model UserEntitlement {
  id                   String                @id @default(cuid())
  userId               String
  projectId            String?
  type                 UserEntitlementType
  status               UserEntitlementStatus @default(ACTIVE)
  source               String
  creditsCost          Int                   @default(0)
  relatedLedgerEntryId String?
  purchaseRecordId     String?
  startsAt             DateTime              @default(now())
  expiresAt            DateTime?
  consumedAt           DateTime?
  metadata             Json
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  relatedLedgerEntry CreditLedgerEntry? @relation("LedgerEntryEntitlements", fields: [relatedLedgerEntryId], references: [id], onDelete: SetNull)
  purchaseRecord     PurchaseRecord?    @relation(fields: [purchaseRecordId], references: [id], onDelete: SetNull)

  @@index([userId, type, status])
  @@index([projectId, type, status])
  @@index([relatedLedgerEntryId])
}

model CreditLedgerEntry {
  id                  String                  @id @default(cuid())
  userId              String
  projectId           String?
  generationJobId     String?
  productId           String?
  purchaseRecordId    String?
  entryType           CreditLedgerEntryType
  status              CreditLedgerEntryStatus @default(SETTLED)
  operation           CreditOperation
  amountCredits       Int
  /// How much of `amountCredits` moved the allowance pool rather than the
  /// purchased one, same sign. Refunds read it back to restore the right pool;
  /// SUM over a period reconciles `UserCreditAccount.planCredits`.
  planCreditsDelta    Int                     @default(0)
  balanceAfterCredits Int?
  idempotencyKey      String                  @unique
  reversesEntryId     String?                 @unique
  description         String?
  metadata            Json
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  generationJob   GenerationJob?     @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  product         ProductCatalog?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  purchaseRecord  PurchaseRecord?    @relation(fields: [purchaseRecordId], references: [id], onDelete: SetNull)
  reversesEntry   CreditLedgerEntry? @relation("CreditLedgerReversal", fields: [reversesEntryId], references: [id], onDelete: SetNull)
  reversedByEntry CreditLedgerEntry? @relation("CreditLedgerReversal")
  entitlements    UserEntitlement[]  @relation("LedgerEntryEntitlements")
  editOperations  BookEditOperation[]
  generationAttempt GenerationAttempt?

  @@index([userId, createdAt])
  @@index([projectId, operation])
  @@index([generationJobId])
  @@index([purchaseRecordId])
}

model PurchaseRecord {
  id                 String          @id @default(cuid())
  userId             String
  productId          String?
  provider           BillingProvider @default(GOOGLE_PLAY)
  externalPurchaseId String?
  purchaseTokenHash  String?
  status             PurchaseStatus  @default(PENDING)
  creditsGranted     Int             @default(0)
  amountMicros       BigInt?
  currency           String          @default("USD")
  purchasedAt        DateTime?
  verifiedAt         DateTime?
  metadata           Json
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      ProductCatalog?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  creditLedger CreditLedgerEntry[]
  entitlements UserEntitlement[]

  @@index([userId, createdAt])
  @@index([provider, externalPurchaseId])
  /// One record per purchase token: concurrent verifications (the Play
  /// listener racing a restore) used to fork duplicate rows, double-counting
  /// cash in the revenue dashboard and letting the same token link to two
  /// accounts. NULL hashes (legacy rows) stay unconstrained.
  @@unique([purchaseTokenHash])
}

model SubscriptionState {
  id                     String             @id @default(cuid())
  userId                 String
  productId              String?
  provider               BillingProvider    @default(GOOGLE_PLAY)
  externalSubscriptionId String?
  /// Raw Google Play token, kept so the renewal sweep can re-verify without the
  /// app. Useless to anyone without our service-account credentials; every other
  /// record stores only the hash.
  purchaseToken          String?
  status                 SubscriptionStatus @default(INACTIVE)
  creditsPerPeriod       Int                @default(0)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  nextCreditGrantAt      DateTime?
  /// What Google last said about renewal. False means the reader has cancelled
  /// and the plan runs to `currentPeriodEnd` — which is not the same as expired.
  autoRenewing           Boolean?
  canceledAt             DateTime?
  metadata               Json
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product ProductCatalog? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  /// One state row per subscription: a duplicate left the renewal sweep
  /// updating one row and polling the other forever.
  @@unique([provider, externalSubscriptionId])
  @@index([status, nextCreditGrantAt])
}

model Project {
  id            String           @id @default(cuid())
  userId        String
  title         String
  subtitle      String?
  authorName    String?
  coverTagline  String?
  prompt        String
  category      TemplateCategory
  subcategory   String?
  targetPages   Int
  complexity    Int
  temperature   Float
  language      String           @default("en")
  mediaSettings Json
  status        ProjectStatus    @default(DRAFT)
  contentRevision Int            @default(0)
  /// A manuscript publication has committed but its old on-disk exports have
  /// not yet been retired. Export publishers claiming the revision named here
  /// must stand down; the revision-scoped tail clears only its own value after
  /// the filesystem work finishes, with a lease-aware stranded sweep as the
  /// crash backstop.
  exportInvalidationRevision Int?
  /// Where each model page landed in the published book.pdf, measured at
  /// publish time from the rendered bytes (see packages/core pdfPageMap.ts).
  /// Stamped with the contentRevision and pdf digest it was measured against;
  /// null for books compiled before the map existed or whose measurement
  /// failed — every consumer must treat its absence as "no translation".
  pdfPageMap    Json?
  /// Rebuilt from Page.storyDelta in index order. Live story-state object for
  /// the context pack and last-page unpaid-promise check.
  storyState    Json?
  templateId    String?
  currentPlanId String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  template           Template?           @relation(fields: [templateId], references: [id])
  currentPlan        PlanVersion?        @relation("CurrentPlan", fields: [currentPlanId], references: [id])
  planVersions       PlanVersion[]       @relation("ProjectPlans")
  chapters           Chapter[]
  pages              Page[]
  characters         Character[]
  locations          Location[]
  continuity         ContinuityNote[]
  research           ResearchSource[]
  images             ImageAsset[]
  jobs               GenerationJob[]
  providerLogs       ProviderCallLog[]
  embeddings         Embedding[]
  voiceCharacters    VoiceCharacter[]
  voiceCalls         VoiceCall[]
  voiceCallEvents    VoiceCallEvent[]
  voiceConversations VoiceConversation[]
  creditLedger       CreditLedgerEntry[]
  entitlements       UserEntitlement[]
  moderationReports  ModerationReport[]
  chatMessages       ProjectChatMessage[]
  editOperations     BookEditOperation[]
  pageEditSnapshots  PageEditSnapshot[]
  archivedPageEditSnapshots ArchivedPageEditSnapshot[]
  mobileCreationOutputs MobileCreationOutput[]
  bookImport         BookImport?
  audiobook          Audiobook?
  generationAttempts GenerationAttempt[]

  @@index([userId, updatedAt])
  @@index([userId, createdAt])
}

model BookImport {
  id        String   @id @default(cuid())
  userId    String
  requestId String?
  projectId String?  @unique
  fileName  String
  mimeType  String
  format    String
  sizeBytes Int
  status    String   @default("UPLOADED")
  error     String?
  stats     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, requestId])
  @@index([userId, createdAt])
}

model MobileCreationDraft {
  id               String   @id @default(cuid())
  requestId        String?  @unique
  userId           String
  payload          Json
  advisorSnapshot  Json?
  lastTurn         Json?
  revision         Int      @default(1)
  createdProjectId String?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  outputs MobileCreationOutput[]

  @@index([userId, status, updatedAt])
  @@index([createdProjectId])
}

model MobileCreationOutput {
  id        String   @id @default(cuid())
  draftId   String
  projectId String
  requestId String?
  title     String
  sequence  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft   MobileCreationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([draftId, projectId])
  @@unique([draftId, sequence])
  @@unique([draftId, requestId])
  @@index([draftId, sequence])
  @@index([projectId])
}

model PlanVersion {
  id              String     @id @default(cuid())
  projectId       String
  version         Int
  status          PlanStatus @default(DRAFT)
  planningPackage Json
  inputSnapshot   Json?
  messages        Json
  approvedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  /// Plan characters whose reference sheet an image provider refused to draw.
  /// Written by the one pass that renders the set, so the next caller reads a
  /// settled answer instead of paying to be refused again. See
  /// apps/worker/src/generation/characterReferences.ts.
  characterReferenceRefusals Json?

  /// Who is currently rendering this plan's reference sheets, and until when.
  /// The renders happen with no transaction and no lock held, so this column
  /// pair is the whole of the cost control: see
  /// apps/worker/src/generation/characterReferenceRenderLease.ts.
  characterReferenceLeaseToken     String?
  characterReferenceLeaseExpiresAt DateTime?

  project    Project  @relation("ProjectPlans", fields: [projectId], references: [id], onDelete: Cascade)
  currentFor Project? @relation("CurrentPlan")

  @@unique([projectId, version])
}

model Chapter {
  id              String   @id @default(cuid())
  projectId       String
  index           Int
  title           String
  summary         String
  targetPages     Int
  productionBrief Json?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages   Page[]

  @@unique([projectId, index])
}

model Page {
  id            String   @id @default(cuid())
  projectId     String
  chapterId     String?
  index         Int
  title         String
  markdown      String
  summary       String
  imagePrompt   String?
  // Set when a planned interior illustration failed after every provider was
  // tried and the book finished without it; null means the page either has its
  // image or was never meant to have one.
  imageFailureReason String?
  qualityReport Json?
  /// Mechanical extract for this page; Project.storyState is rebuilt from these.
  storyDelta    Json?
  status        String   @default("PENDING")
  revision      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter Chapter?     @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  images  ImageAsset[]
  editSnapshots PageEditSnapshot[]
  continuityNotes ContinuityNote[]

  @@unique([projectId, index])
}

model ProjectChatMessage {
  id            String                 @id @default(cuid())
  projectId     String
  requestId     String?
  parentId      String?
  role          ProjectChatMessageRole
  content       String
  operationId   String?
  metadata      Json
  isActiveChild Boolean                @default(true)
  createdAt     DateTime               @default(now())

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    ProjectChatMessage? @relation("ProjectChatMessageBranches", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProjectChatMessage[] @relation("ProjectChatMessageBranches")
  operation BookEditOperation? @relation("ProjectChatOperationMessages", fields: [operationId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@unique([projectId, requestId])
  @@index([projectId, parentId])
  @@index([parentId])
  @@index([operationId])
}

/// Migration 000026 adds a raw partial unique index
/// ("BookEditOperation_one_open_per_project" on projectId WHERE status IN
/// ('QUEUED','ACTIVE')) that Prisma's DSL cannot express. It guarantees at most
/// one open edit per project; `prisma migrate diff` will not know about it.
model BookEditOperation {
  id                  String                  @id @default(cuid())
  projectId           String
  requestId           String?
  userMessageId       String?
  assistantMessageId  String?
  generationJobId     String?
  ledgerEntryId       String?
  kind                BookEditOperationKind
  status              BookEditOperationStatus @default(QUEUED)
  request             String
  /// Standalone execution instruction resolved before the proposal is shown.
  editInstruction     String?
  /// Supplemental mentioned-character canon. Never part of the approved edit instruction.
  characterContext    String?
  /// Immutable manuscript source for a full-book replan copy. Legacy rows
  /// fall back to projectId, which was already the source-side operation owner.
  sourceProjectId     String?
  classifier          Json
  /// Compact instruction-adherence verdict and attempt history.
  adherenceAudit      Json?
  affectedPageIndexes Int[]
  creditsCharged      Int                     @default(0)
  automaticRetryCount Int                     @default(0)
  automaticRetryLimit Int                     @default(2)
  nextRetryAt         DateTime?
  lastRetryAt         DateTime?
  lastRetryReason     String?
  retryRequestId      String?
  /// Per-delivery ownership for the long drafting phase of a structural edit.
  /// Database-time expiry lets a crash redelivery take over without admitting
  /// a second live delivery while the current owner is heartbeating.
  structuralLeaseToken       String?
  structuralLeaseExpiresAt   DateTime?
  structuralLeaseCompletedAt DateTime?
  error               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  appliedAt           DateTime?
  /// Project.contentRevision this operation published when it became APPLIED.
  /// The worker uses it with operation order to fence delayed publication tails.
  publicationRevision Int?

  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationJob     GenerationJob?       @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  ledgerEntry       CreditLedgerEntry?   @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  snapshots         PageEditSnapshot[]
  archivedSnapshots ArchivedPageEditSnapshot[]
  operationMessages ProjectChatMessage[] @relation("ProjectChatOperationMessages")
  generationAttempts GenerationAttempt[]

  @@index([projectId, createdAt])
  @@unique([projectId, requestId])
  @@unique([retryRequestId])
  @@index([status, nextRetryAt])
  @@index([generationJobId])
  @@index([ledgerEntryId])
}

model PageEditSnapshot {
  id              String   @id @default(cuid())
  projectId       String
  pageId          String
  operationId     String
  pageIndex       Int
  titleBefore     String
  markdownBefore  String
  summaryBefore   String
  revisionBefore  Int
  /// Page.storyDelta as it stood before this edit. Undo restores it; SQL NULL
  /// means the page had no delta, not that the extract should be wiped.
  storyDeltaBefore Json?
  titleAfter      String?
  markdownAfter   String?
  summaryAfter    String?
  revisionAfter   Int?
  createdAt       DateTime @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page      Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  operation BookEditOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([projectId, pageIndex])
  @@index([operationId])
  @@index([pageId])
}

/// A PageEditSnapshot parked while a structural delete keeps its Page absent.
/// There is deliberately no Page foreign key: that cascade is exactly what this
/// archive survives. `archiveKey` is the structural stamp's bounded restore
/// pointer, not a foreign key, so retiring that structural operation leaves the
/// older, now-incomplete operation blocked from partial Undo.
model ArchivedPageEditSnapshot {
  /// The original snapshot id. Restoring with this id makes replay idempotent.
  id               String   @id
  projectId        String
  pageId           String
  operationId      String
  archiveKey       String
  pageIndex        Int
  titleBefore      String
  markdownBefore   String
  summaryBefore    String
  revisionBefore   Int
  storyDeltaBefore Json?
  titleAfter       String?
  markdownAfter    String?
  summaryAfter     String?
  revisionAfter    Int?
  createdAt        DateTime
  archivedAt       DateTime @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  operation BookEditOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([projectId, archiveKey])
  @@index([operationId])
  @@index([pageId])
}

model Character {
