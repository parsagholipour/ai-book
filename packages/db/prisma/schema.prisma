generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum TemplateCategory {
  KIDS
  SCIENCE
  STORY
  EDUCATION
  BUSINESS
  SELF_HELP
  HEALTH
  BIOGRAPHY
  HISTORY
  SOCIETY
  ARTS
  CUSTOM
}

enum ProjectStatus {
  DRAFT
  PLANNING
  PLAN_READY
  GENERATING
  EDITING
  REVIEW_REQUIRED
  COMPLETE
  FAILED
}

enum PlanStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  CANCELED
  FAILED
}

enum JobType {
  PLAN_BOOK
  REVISE_PLAN
  GENERATE_BOOK
  GENERATE_PAGE
  GENERATE_IMAGE
  COMPILE_EXPORT
  APPLY_BOOK_EDIT
  REPLAN_BOOK
  PREPARE_CHARACTER_CANDIDATES
  BUILD_CHARACTER_PERSONA
  RESEARCH
}

enum AssetType {
  COVER
  CHARACTER_REFERENCE
  CHARACTER_PROFILE
  SCENE_ILLUSTRATION
  DIAGRAM
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BillingProductType {
  ONE_TIME_UNLOCK
  CREDIT_PACK
  SUBSCRIPTION
  INTERNAL_GRANT
}

enum BillingProvider {
  INTERNAL
  GOOGLE_PLAY
}

enum PurchaseStatus {
  PENDING
  VERIFIED
  GRANTED
  FAILED
  REVOKED
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  GRACE_PERIOD
  PAUSED
  CANCELED
  EXPIRED
}

enum UserEntitlementType {
  EXPORT_UNLOCK
  PREMIUM_PRESET
  PREMIUM_REVIEW
  EXTRA_IMAGES
  CREATOR_PLAN
  PRO_PLAN
}

enum UserEntitlementStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
}

enum CreditLedgerEntryType {
  GRANT
  RESERVE
  SPEND
  REFUND
  RELEASE
  ADJUSTMENT
}

enum CreditLedgerEntryStatus {
  RESERVED
  SETTLED
  REFUNDED
  VOIDED
}

enum CreditOperation {
  PLAN_GENERATION
  PREVIEW_GENERATION
  FULL_BOOK_GENERATION
  IMAGE_GENERATION
  COVER_REGENERATION
  PREMIUM_REVIEW
  EXPORT_UNLOCK
  PLAN_REVISION
  BOOK_TEXT_EDIT
  PAGE_REGENERATION
  BOOK_REPLAN
  PURCHASE_CREDIT_GRANT
  SUBSCRIPTION_CREDIT_GRANT
  ADMIN_GRANT
}

enum ProjectChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum BookEditOperationKind {
  PLAN_REVISION
  LOCAL_PATCH
  PAGE_REWRITE
  CHAPTER_REGENERATE
  BOOK_REPLAN
  MANUAL_EDIT
}

enum BookEditOperationStatus {
  QUEUED
  ACTIVE
  APPLIED
  FAILED
  CANCELED
}

enum ModerationReportTargetType {
  PROJECT
  IMAGE_ASSET
}

enum ModerationReportReason {
  OFFENSIVE
  HATE_OR_HARASSMENT
  SEXUAL_CONTENT
  VIOLENCE_OR_SELF_HARM
  CHILD_SAFETY
  DECEPTIVE_OR_MISLEADING
  PRIVACY_OR_COPYRIGHT
  OTHER
}

enum ModerationReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

enum AccountDeletionRequestStatus {
  PENDING
  COMPLETED
  CANCELED
  REJECTED
}

enum VoiceCharacterStatus {
  CANDIDATE
  APPROVED
  BUILDING
  READY
  REJECTED
  FAILED
}

model Template {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  category      TemplateCategory
  description   String
  defaultConfig Json
  styleRules    Json
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  projects      Project[]
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  displayName String?
  status      UserStatus @default(ACTIVE)
  disabledAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  passwordCredential      UserPasswordCredential?
  mobileSessions          MobileSession[]
  projects                Project[]
  creditAccount           UserCreditAccount?
  creditLedger            CreditLedgerEntry[]
  entitlements            UserEntitlement[]
  purchases               PurchaseRecord[]
  subscriptions           SubscriptionState[]
  moderationReports       ModerationReport[]       @relation("ModerationReportReporter")
  moderationReviews       ModerationReport[]       @relation("ModerationReportReviewer")
  accountDeletionRequests AccountDeletionRequest[]
  mobileCreationDrafts    MobileCreationDraft[]
}

model UserPasswordCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MobileSession {
  id                       String    @id @default(cuid())
  userId                   String
  accessTokenHash          String    @unique
  refreshTokenHash         String    @unique
  previousRefreshTokenHash String?   @unique
  refreshTokenRotatedAt    DateTime?
  accessTokenExpiresAt     DateTime
  refreshTokenExpiresAt    DateTime
  userAgent                String?
  ipHash                   String?
  revokedAt                DateTime?
  lastUsedAt               DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([accessTokenExpiresAt])
  @@index([refreshTokenExpiresAt])
}

model ProductCatalog {
  id           String             @id @default(cuid())
  sku          String             @unique
  title        String
  description  String?
  productType  BillingProductType
  provider     BillingProvider    @default(GOOGLE_PLAY)
  creditAmount Int                @default(0)
  priceMicros  BigInt?
  currency     String             @default("USD")
  active       Boolean            @default(true)
  metadata     Json
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  creditLedger  CreditLedgerEntry[]
  purchases     PurchaseRecord[]
  subscriptions SubscriptionState[]
}

model UserCreditAccount {
  userId                 String   @id
  availableCredits       Int      @default(0)
  reservedCredits        Int      @default(0)
  lifetimeCreditsGranted Int      @default(0)
  lifetimeCreditsSpent   Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserEntitlement {
  id                   String                @id @default(cuid())
  userId               String
  projectId            String?
  type                 UserEntitlementType
  status               UserEntitlementStatus @default(ACTIVE)
  source               String
  creditsCost          Int                   @default(0)
  relatedLedgerEntryId String?
  purchaseRecordId     String?
  startsAt             DateTime              @default(now())
  expiresAt            DateTime?
  consumedAt           DateTime?
  metadata             Json
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  relatedLedgerEntry CreditLedgerEntry? @relation("LedgerEntryEntitlements", fields: [relatedLedgerEntryId], references: [id], onDelete: SetNull)
  purchaseRecord     PurchaseRecord?    @relation(fields: [purchaseRecordId], references: [id], onDelete: SetNull)

  @@index([userId, type, status])
  @@index([projectId, type, status])
  @@index([relatedLedgerEntryId])
}

model CreditLedgerEntry {
  id                  String                  @id @default(cuid())
  userId              String
  projectId           String?
  generationJobId     String?
  productId           String?
  purchaseRecordId    String?
  entryType           CreditLedgerEntryType
  status              CreditLedgerEntryStatus @default(SETTLED)
  operation           CreditOperation
  amountCredits       Int
  balanceAfterCredits Int?
  idempotencyKey      String                  @unique
  reversesEntryId     String?                 @unique
  description         String?
  metadata            Json
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  generationJob   GenerationJob?     @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  product         ProductCatalog?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  purchaseRecord  PurchaseRecord?    @relation(fields: [purchaseRecordId], references: [id], onDelete: SetNull)
  reversesEntry   CreditLedgerEntry? @relation("CreditLedgerReversal", fields: [reversesEntryId], references: [id], onDelete: SetNull)
  reversedByEntry CreditLedgerEntry? @relation("CreditLedgerReversal")
  entitlements    UserEntitlement[]  @relation("LedgerEntryEntitlements")
  editOperations  BookEditOperation[]

  @@index([userId, createdAt])
  @@index([projectId, operation])
  @@index([generationJobId])
  @@index([purchaseRecordId])
}

model PurchaseRecord {
  id                 String          @id @default(cuid())
  userId             String
  productId          String?
  provider           BillingProvider @default(GOOGLE_PLAY)
  externalPurchaseId String?
  purchaseTokenHash  String?
  status             PurchaseStatus  @default(PENDING)
  creditsGranted     Int             @default(0)
  amountMicros       BigInt?
  currency           String          @default("USD")
  purchasedAt        DateTime?
  verifiedAt         DateTime?
  metadata           Json
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      ProductCatalog?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  creditLedger CreditLedgerEntry[]
  entitlements UserEntitlement[]

  @@index([userId, createdAt])
  @@index([provider, externalPurchaseId])
  @@index([purchaseTokenHash])
}

model SubscriptionState {
  id                     String             @id @default(cuid())
  userId                 String
  productId              String?
  provider               BillingProvider    @default(GOOGLE_PLAY)
  externalSubscriptionId String?
  status                 SubscriptionStatus @default(INACTIVE)
  creditsPerPeriod       Int                @default(0)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  nextCreditGrantAt      DateTime?
  canceledAt             DateTime?
  metadata               Json
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product ProductCatalog? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([provider, externalSubscriptionId])
}

model Project {
  id            String           @id @default(cuid())
  userId        String
  title         String
  subtitle      String?
  authorName    String?
  coverTagline  String?
  prompt        String
  category      TemplateCategory
  subcategory   String?
  targetPages   Int
  complexity    Int
  temperature   Float
  language      String           @default("en")
  mediaSettings Json
  status        ProjectStatus    @default(DRAFT)
  contentRevision Int            @default(0)
  templateId    String?
  currentPlanId String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  template           Template?           @relation(fields: [templateId], references: [id])
  currentPlan        PlanVersion?        @relation("CurrentPlan", fields: [currentPlanId], references: [id])
  planVersions       PlanVersion[]       @relation("ProjectPlans")
  chapters           Chapter[]
  pages              Page[]
  characters         Character[]
  locations          Location[]
  continuity         ContinuityNote[]
  research           ResearchSource[]
  images             ImageAsset[]
  jobs               GenerationJob[]
  providerLogs       ProviderCallLog[]
  embeddings         Embedding[]
  voiceCharacters    VoiceCharacter[]
  voiceCallEvents    VoiceCallEvent[]
  voiceConversations VoiceConversation[]
  creditLedger       CreditLedgerEntry[]
  entitlements       UserEntitlement[]
  moderationReports  ModerationReport[]
  chatMessages       ProjectChatMessage[]
  editOperations     BookEditOperation[]
  pageEditSnapshots  PageEditSnapshot[]
  mobileCreationOutputs MobileCreationOutput[]

  @@index([userId, updatedAt])
  @@index([userId, createdAt])
}

model MobileCreationDraft {
  id               String   @id @default(cuid())
  requestId        String?  @unique
  userId           String
  payload          Json
  advisorSnapshot  Json?
  lastTurn         Json?
  revision         Int      @default(1)
  createdProjectId String?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  outputs MobileCreationOutput[]

  @@index([userId, status, updatedAt])
  @@index([createdProjectId])
}

model MobileCreationOutput {
  id        String   @id @default(cuid())
  draftId   String
  projectId String
  requestId String?
  title     String
  sequence  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft   MobileCreationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([draftId, projectId])
  @@unique([draftId, sequence])
  @@unique([draftId, requestId])
  @@index([draftId, sequence])
  @@index([projectId])
}

model PlanVersion {
  id              String     @id @default(cuid())
  projectId       String
  version         Int
  status          PlanStatus @default(DRAFT)
  planningPackage Json
  inputSnapshot   Json?
  messages        Json
  approvedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  project    Project  @relation("ProjectPlans", fields: [projectId], references: [id], onDelete: Cascade)
  currentFor Project? @relation("CurrentPlan")

  @@unique([projectId, version])
}

model Chapter {
  id              String   @id @default(cuid())
  projectId       String
  index           Int
  title           String
  summary         String
  targetPages     Int
  productionBrief Json?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages   Page[]

  @@unique([projectId, index])
}

model Page {
  id            String   @id @default(cuid())
  projectId     String
  chapterId     String?
  index         Int
  title         String
  markdown      String
  summary       String
  imagePrompt   String?
  qualityReport Json?
  status        String   @default("PENDING")
  revision      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter Chapter?     @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  images  ImageAsset[]
  editSnapshots PageEditSnapshot[]

  @@unique([projectId, index])
}

model ProjectChatMessage {
  id            String                 @id @default(cuid())
  projectId     String
  requestId     String?
  parentId      String?
  role          ProjectChatMessageRole
  content       String
  operationId   String?
  metadata      Json
  isActiveChild Boolean                @default(true)
  createdAt     DateTime               @default(now())

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    ProjectChatMessage? @relation("ProjectChatMessageBranches", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProjectChatMessage[] @relation("ProjectChatMessageBranches")
  operation BookEditOperation? @relation("ProjectChatOperationMessages", fields: [operationId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@unique([projectId, requestId])
  @@index([projectId, parentId])
  @@index([parentId])
  @@index([operationId])
}

/// Migration 000026 adds a raw partial unique index
/// ("BookEditOperation_one_open_per_project" on projectId WHERE status IN
/// ('QUEUED','ACTIVE')) that Prisma's DSL cannot express. It guarantees at most
/// one open edit per project; `prisma migrate diff` will not know about it.
model BookEditOperation {
  id                  String                  @id @default(cuid())
  projectId           String
  requestId           String?
  userMessageId       String?
  assistantMessageId  String?
  generationJobId     String?
  ledgerEntryId       String?
  kind                BookEditOperationKind
  status              BookEditOperationStatus @default(QUEUED)
  request             String
  classifier          Json
  affectedPageIndexes Int[]
  creditsCharged      Int                     @default(0)
  error               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  appliedAt           DateTime?

  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationJob     GenerationJob?       @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  ledgerEntry       CreditLedgerEntry?   @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  snapshots         PageEditSnapshot[]
  operationMessages ProjectChatMessage[] @relation("ProjectChatOperationMessages")

  @@index([projectId, createdAt])
  @@unique([projectId, requestId])
  @@index([generationJobId])
  @@index([ledgerEntryId])
}

model PageEditSnapshot {
  id              String   @id @default(cuid())
  projectId       String
  pageId          String
  operationId     String
  pageIndex       Int
  titleBefore     String
  markdownBefore  String
  summaryBefore   String
  revisionBefore  Int
  titleAfter      String?
  markdownAfter   String?
  summaryAfter    String?
  revisionAfter   Int?
  createdAt       DateTime @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page      Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  operation BookEditOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([projectId, pageIndex])
  @@index([operationId])
  @@index([pageId])
}

model Character {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  role        String
  description String
  traits      Json
  visualRules Json
  state       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model VoiceCharacter {
  id                  String               @id @default(cuid())
  projectId           String
  planVersionId       String?
  name                String
  role                String
  description         String
  traits              Json
  visualRules         Json
  source              String               @default("PLAN")
  status              VoiceCharacterStatus @default(CANDIDATE)
  persona             Json?
  voiceProfile        Json
  voiceProvider       String               @default("gemini_live")
  voiceModel          String?
  voiceId             String?
  providerMetadata    Json
  profileImageAssetId String?
  error               String?
  approvedAt          DateTime?
  builtAt             DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  callEvents VoiceCallEvent[]

  @@index([projectId, status])
  @@index([planVersionId])
}

model Location {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String
  rules       Json
  state       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ContinuityNote {
  id        String   @id @default(cuid())
  projectId String
  scope     String
  body      String
  tags      String[]
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ResearchSource {
  id          String    @id @default(cuid())
  projectId   String
  query       String
  title       String
  url         String?
  summary     String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ImageAsset {
  id        String    @id @default(cuid())
  projectId String
  pageId    String?
  type      AssetType
  prompt    String
  provider  String
  path      String
  metadata  Json
  createdAt DateTime  @default(now())

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page              Page?              @relation(fields: [pageId], references: [id], onDelete: SetNull)
  moderationReports ModerationReport[]
}

model ModerationReport {
  id             String                     @id @default(cuid())
  reporterUserId String?
  projectId      String?
  imageAssetId   String?
  targetType     ModerationReportTargetType
  reason         ModerationReportReason
  comment        String?
  status         ModerationReportStatus     @default(PENDING)
  targetSnapshot Json
  reviewerUserId String?
  reviewedAt     DateTime?
  reviewNotes    String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  reporter   User?       @relation("ModerationReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reviewer   User?       @relation("ModerationReportReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  imageAsset ImageAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@index([reporterUserId, createdAt])
  @@index([projectId, createdAt])
  @@index([imageAssetId, createdAt])
  @@index([status, createdAt])
}

model AccountDeletionRequest {
  id          String                       @id @default(cuid())
  userId      String?
  email       String
  status      AccountDeletionRequestStatus @default(PENDING)
  reason      String?
  metadata    Json
  requestedAt DateTime                     @default(now())
  completedAt DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([email, requestedAt])
}

model GenerationJob {
  id         String    @id @default(cuid())
  projectId  String
  type       JobType
  status     JobStatus @default(QUEUED)
  dedupeKey  String?   @unique
  progress   Int       @default(0)
  message    String?
  error      String?
  bullJobId  String?
  dispatchAttempts Int @default(0)
  nextDispatchAt DateTime?
  dispatchedAt DateTime?
  contentRevision Int?
  qualityReport Json?
  payload    Json
  steps      Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  providerLogs ProviderCallLog[]
  creditLedger CreditLedgerEntry[]
  editOperations BookEditOperation[]

  @@index([projectId, type, status])
  @@index([status, nextDispatchAt])
}

model ProviderCallLog {
  id              String   @id @default(cuid())
  projectId       String?
  generationJobId String?
  provider        String
  model           String
  purpose         String
  promptTokens    Int?
  outputTokens    Int?
  cacheHitTokens  Int?
  costHint        Float?
  durationMs      Int?
  metadata        Json
  createdAt       DateTime @default(now())

  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  generationJob GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([generationJobId])
}

model VoiceCallEvent {
  id                     String   @id @default(cuid())
  projectId              String
  characterId            String
  clientCallId           String
  phase                  String
  attempt                Int?
  elapsedMs              Int?
  connectionState        String?
  iceConnectionState     String?
  iceGatheringState      String?
  candidatePairType      String?
  candidateProtocol      String?
  currentRoundTripTimeMs Int?
  packetsLost            Int?
  jitterMs               Int?
  error                  String?
  metadata               Json
  createdAt              DateTime @default(now())

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voiceCharacter VoiceCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([characterId, createdAt])
  @@index([clientCallId])
}

model VoiceConversation {
  id                   String   @id @default(cuid())
  projectId            String
  parentConversationId String?
  rootConversationId   String?
  prompt               String
  characterSnapshots   Json
  transcript           Json
  provider             String
  model                String
  audioPath            String
  durationMs           Int?
  metadata             Json
  createdAt            DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([parentConversationId])
  @@index([rootConversationId, createdAt])
}

model Embedding {
  id        String   @id @default(cuid())
  projectId String
  scope     String
  sourceId  String?
  text      String
  metadata  Json
  createdAt DateTime @default(now())

