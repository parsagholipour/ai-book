/// One narrated rendering of a book. There is at most one per project: asking for
/// a new narrator replaces the old row (and its files) rather than versioning it.
/// `contentRevision` is the project revision the narration was read from, which is
/// what lets the app say "this audiobook predates your latest edits".
model Audiobook {
  id              String          @id @default(cuid())
  projectId       String          @unique
  voice           String
  status          AudiobookStatus @default(GENERATING)
  contentRevision Int?
  totalDurationMs Int?
  speechProvider  String?
  speechModel     String?
  speechVoice     String?
  fallbackReason  String?
  renderVersion   Int             @default(1)
  generationJobId String?
  error           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapters AudiobookChapter[]
}

/// Audio and its sentence timeline live on disk under
/// <AUDIO_STORAGE_DIR>/<projectId>/<audiobookId>/chapter-<index>.{mp3,timeline.json},
/// so the row carries no path — only the facts the manifest needs before a
/// download. A chapter flips to READY only once both files are in place, which is
/// what makes a retried job safe to resume.
model AudiobookChapter {
  id                  String                 @id @default(cuid())
  audiobookId         String
  index               Int
  title               String
  status              AudiobookChapterStatus @default(PENDING)
  durationMs          Int?
  estimatedDurationMs Int?
  byteSize            Int?
  segmentCount        Int?
  pageStartIndex      Int?
  pageEndIndex        Int?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  audiobook Audiobook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([audiobookId, index])
  @@index([audiobookId, index])
}

model Embedding {
  id        String   @id @default(cuid())
  projectId String
  scope     String
  sourceId  String?
  text      String
  metadata  Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, scope])
}
