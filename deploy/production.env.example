# Copy this content into the production environment secret PRODUCTION_ENV.
#
# The API and worker refuse to start in production while any REQUIRED setting
# below is missing or unusable, and the deploy runs the same check in the new
# image before it stops the running release, so a gap fails the deploy instead
# of taking the site down (packages/core/src/productionConfig.ts). The check
# names every missing setting at once and never prints a value.
#
# The whole secret is one SSM parameter, capped at 8 KB. The two service-account
# keys are the bulk of it; see docs/deployment.md if it gets close.

# ---- Required ---------------------------------------------------------------

# Keep POSTGRES_PASSWORD unchanged after the database is first initialized.
# Use only URL-safe characters, e.g. a password generated by openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
# The operator console, /api/admin and /docs. 16+ characters, and not this
# placeholder: e.g. openssl rand -hex 24.
WEB_PASSWORD=replace-with-a-strong-operator-password
# The public https origin served by the Caddy edge; picture, cover and share
# URLs are stored with it.
PUBLIC_API_URL=https://tomeza.ravanix.app

# Google Play billing. Without the package and service account every purchase
# answers 503 and is never acknowledged, so Google refunds it after three days.
# The service account needs "View financial data" and "Manage orders and
# subscriptions" in Play Console. Paste the key file's JSON single-quoted on one
# line (GOOGLE_PLAY_SERVICE_ACCOUNT_FILE is the alternative when the key is a
# file inside the container).
GOOGLE_PLAY_PACKAGE_NAME=com.tomeza.tomeza
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Refund and cancellation notices (docs/google-play-rtdn.md). Without them the
# notice endpoint answers 503 and a refunded purchase keeps its credits. The
# audience must equal the Pub/Sub push subscription's audience exactly.
GOOGLE_PLAY_RTDN_AUDIENCE=https://tomeza.ravanix.app/api/billing/google-play/rtdn
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# Password reset mail. Without it forgot-password answers 503 and a reader who
# forgets their password is locked out. smtp(s)://user:pass@host:port
SMTP_URL=
EMAIL_FROM=Tomeza <no-reply@ravanix.app>

# Model providers: every provider the default model routing can select needs its
# key (text: DeepSeek, DeepInfra, Gemini, Alibaba; pictures: Gemini with an
# Alibaba fallback; embeddings, search, OCR, narration and voice calls: Gemini;
# narration past Gemini's daily speech quota: OpenAI). The list is derived from
# the routing, so if the check names a key that is not here, add it.
DEEPSEEK_API_KEY=
DEEPINFRA_API_KEY=
GEMINI_API_KEY=
ALIBABA_API_KEY=
# Or set AUDIOBOOK_OPENAI_FALLBACK_ENABLED=false to narrate on Gemini alone.
OPENAI_API_KEY=
MOCK_AI=false

# ---- Recommended (logged at boot when missing, never fatal) -----------------

# Who is emailed when production is down or degraded: a worker lane stopped,
# a stuck queue, a burst of failed jobs, low disk, an AI spend cap reached
# (docs/deployment.md, "Monitoring and alerts"). Sent through SMTP_URL. One
# address or a comma-separated list. Without it the alerts only reach the API
# log, and the deploy prints a warning.
OPERATOR_ALERT_EMAIL=

# Google sign-in uses a Web OAuth client ID (not the Play service account).
# Use the same value in the Flutter build. See docs/google-sign-in.md.
GOOGLE_SIGN_IN_CLIENT_ID=
# Book-progress and book-ready notifications (docs/push-notifications.md). A
# Firebase service-account key, single-quoted on one line. Without it the API
# sends no pushes and says so once in its log.
FCM_SERVICE_ACCOUNT_JSON=

# ---- Optional ---------------------------------------------------------------

# Only when the operator console's Quality tab routes to them. The API and
# worker log a warning at boot when the saved routing names one without its key.
# OPENROUTER_API_KEY=
# VERCEL_AI_GATEWAY_API_KEY=

SUPPORT_EMAIL=support@ravanix.app
MAX_PARALLEL_PAGE_JOBS=1
MAX_PARALLEL_IMAGE_JOBS=1
# The worker's two job lanes (docs/deployment.md, "Job lanes"); these are the
# compose defaults, sized for the worker's 2 GiB.
WORKER_LONG_CONCURRENCY=1
WORKER_INTERACTIVE_CONCURRENCY=2
# Caddy → Nginx → API. Trust both hops so request.ip is the real client.
# Production also defaults to 2 when this key is omitted from PRODUCTION_ENV.
TRUST_PROXY_HOPS=2
# Let's Encrypt account contact for the Caddy edge (expiry/problem notices).
# ACME_EMAIL=support@ravanix.app

# S3_BUCKET and S3_REGION are injected from Terraform during deployment.
# EC2 uses its IAM role. Keep local MinIO endpoint/credentials out of this secret.
# Never set ALLOW_MOCK_AI_IN_PRODUCTION here: it is the CI smoke test's switch.

# GEMINI_API_KEY also enables Google OCR when local OCR is absent or fails.
# Google OCR sends the affected page/image to Google and incurs API usage.
# Optional local OCR service (tried before Google); not hosted on the 4 GiB EC2 (no room in its memory budget).
# SOURCE_OCR_URL=http://your-private-ocr-service:8080
# Optional override; defaults to GEMINI_TEXT_MODEL.
# GEMINI_OCR_MODEL=gemini-2.5-flash
# SOURCE_OCR_TIMEOUT_MS=600000
