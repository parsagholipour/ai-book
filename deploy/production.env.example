# Copy this content into the production environment secret PRODUCTION_ENV.
# Keep POSTGRES_PASSWORD unchanged after the database is first initialized.
# Use only URL-safe characters, e.g. a password generated by openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
WEB_PASSWORD=replace-with-a-strong-operator-password
# The public origin served by the Caddy edge; image and asset URLs are built from it.
PUBLIC_API_URL=https://tomeza.ravanix.app
# Caddy → Nginx → API. Trust both hops so request.ip is the real client.
# Production also defaults to 2 when this key is omitted from PRODUCTION_ENV.
TRUST_PROXY_HOPS=2
# Let's Encrypt account contact for the Caddy edge (expiry/problem notices).
# ACME_EMAIL=support@ravanix.app

# S3_BUCKET and S3_REGION are injected from Terraform during deployment.
# EC2 uses its IAM role. Keep local MinIO endpoint/credentials out of this secret.

# Required for launch. Without the Play pair every purchase answers 503 and is
# never acknowledged, so Google refunds it after three days. The service account
# needs "View financial data" and "Manage orders and subscriptions" in Play Console.
GOOGLE_PLAY_PACKAGE_NAME=com.tomeza.tomeza
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Without SMTP the forgot-password route answers 503 and a reader who forgets
# their password is locked out. smtp(s)://user:pass@host:port
SMTP_URL=
EMAIL_FROM=Tomeza <no-reply@ravanix.app>
# Book-progress and book-ready notifications (docs/push-notifications.md). A
# Firebase service-account key, single-quoted on one line. Without it the API
# sends no pushes and says so once in its log.
FCM_SERVICE_ACCOUNT_JSON=
SUPPORT_EMAIL=support@ravanix.app

# Copy the provider keys/settings you use from .env.example.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MOCK_AI=false
MAX_PARALLEL_PAGE_JOBS=1
MAX_PARALLEL_IMAGE_JOBS=1

# GEMINI_API_KEY also enables Google OCR when local OCR is absent or fails.
# Google OCR sends the affected page/image to Google and incurs API usage.
# Optional local OCR service (tried before Google); not hosted on the 2 GiB EC2.
# SOURCE_OCR_URL=http://your-private-ocr-service:8080
# Optional override; defaults to GEMINI_TEXT_MODEL.
# GEMINI_OCR_MODEL=gemini-2.5-flash
# SOURCE_OCR_TIMEOUT_MS=600000
