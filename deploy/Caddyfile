# Production edge (docker-compose.production.yml `caddy` service). Caddy owns
# host ports 80 and 443, terminates TLS for the public hostname and hands every
# request to the web container's Nginx, which stays HTTP-only on the Compose
# network and same-origins the console, /api, /docs and /assets. Certificates
# come from Let's Encrypt and persist in the caddy-data volume across deploys.
#
# Limits live in nginx.conf: Caddy adds no request body cap (Nginx: 100m) and
# no upstream read timeout (Nginx: 600s). ACME_EMAIL is set by Compose.
{
	email {$ACME_EMAIL}
	# The security group opens TCP only, so do not advertise HTTP/3 over UDP.
	servers {
		protocols h1 h2
	}
}

# Automatic HTTPS: certificate via HTTP-01 on :80 / TLS-ALPN-01 on :443, and
# plain http://tomeza.ravanix.app redirects here.
tomeza.ravanix.app {
	reverse_proxy web:80 {
		# Host, X-Forwarded-For and X-Forwarded-Proto are forwarded by default.
		header_up X-Real-IP {remote_host}
		# Stream every upstream write as it arrives (Nginx: proxy_buffering off).
		flush_interval -1
	}
}

# The host's own checks: scripts/deploy-production.sh curls
# http://127.0.0.1/api/health through the whole edge. Docker hands those
# connections over from the bridge gateway, so allow private sources only; a
# client on the internet spoofing this Host header gets nothing.
http://127.0.0.1 {
	@private remote_ip private_ranges
	handle @private {
		reverse_proxy web:80
	}
	respond 404
}
